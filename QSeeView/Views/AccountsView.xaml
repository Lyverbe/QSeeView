<Window x:Class="QSeeView.Views.AccountsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QSeeView.Views"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ThemeBackgroundBrush}" Foreground="{StaticResource ThemeForegroundBrush}"
        Title="Accounts" Height="600" Width="600">
    <DockPanel Margin="10">
        <Button DockPanel.Dock="Bottom" Content="Close" Command="{Binding CloseCommand}" HorizontalAlignment="Right" Margin="0,5,0,0" />

        <DockPanel DockPanel.Dock="Left" Width="150">
            <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,5,0,0">
                <Button Content="Add..." Command="{Binding AddAccountCommand}" />
                <Button Content="Delete..." Command="{Binding DeleteAccountCommand}" Margin="5,0,0,0" />
            </UniformGrid>
            <TextBlock DockPanel.Dock="Top" Text="Accounts" />
            <ListBox ItemsSource="{Binding Accounts}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedAccount}"
                     SelectedIndex="{Binding SelectedAccountIndex}"
                     Background="{StaticResource ThemeBackgroundBrush}" Foreground="{StaticResource ThemeForegroundBrush}" />
        </DockPanel>

        <GroupBox Header="Details" Margin="5,0,0,0">
            <DockPanel DockPanel.Dock="Top" Margin="2">
                <Button DockPanel.Dock="Bottom" Content="Update" Command="{Binding UpdateCommand}"
                        Margin="0,5,0,0" HorizontalAlignment="Right" />

                <Grid DockPanel.Dock="Top" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="2" />
                        <RowDefinition />
                        <RowDefinition Height="2" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Name " />
                    <TextBox Grid.Column="1" Text="{Binding Name}" MaxLength="128" PreviewKeyDown="TextBox_PreviewKeyDown" />
                    <TextBlock Grid.Row="2" Text="Group " />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                              DisplayMemberPath="Name" />
                    <TextBlock Grid.Row="4" Text="Memo " />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Memo}" MaxLength="128" />
                </Grid>

                <GroupBox DockPanel.Dock="Top" Margin="0,5,0,0">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="PasswordCheckBox" IsChecked="{Binding IsPasswordChanged}" />
                            <TextBlock Text=" Password" />
                        </StackPanel>
                    </GroupBox.Header>
                    <Grid DockPanel.Dock="Top" VerticalAlignment="Top" Margin="2" IsEnabled="{Binding IsChecked, ElementName=PasswordCheckBox}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="2" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Old password " />
                        <TextBox Grid.Column="1" Text="{Binding OldPassword, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" />
                        <TextBlock Grid.Row="2" Text="New password " />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" />
                    </Grid>
                </GroupBox>

                <DockPanel Margin="0,5,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="Rights" />
                    <ListBox ItemsSource="{Binding Rights}" Margin="0,2,0,0"
                             Background="{StaticResource ThemeBackgroundBrush}" Foreground="{StaticResource ThemeForegroundBrush}">
                        <ListBox.ItemTemplate>
                            <ItemContainerTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsOwned}" />
                                    <TextBlock Text="{Binding Memo}" />
                                </StackPanel>
                            </ItemContainerTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </DockPanel>
        </GroupBox>
    </DockPanel>
</Window>
