<Window x:Class="QSeeView.Views.LogsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ThemeBackgroundBrush}" Foreground="{StaticResource ThemeForegroundBrush}"
        Title="Logs" Height="600" Width="800" MinHeight="400" MinWidth="450">
    <DockPanel Margin="10">
        <UniformGrid DockPanel.Dock="Bottom" Columns="2" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button Content="Clear" Command="{Binding ClearCommand}" />
            <Button Content="Close" Command="{Binding CloseCommand}" Margin="5,0,0,0" />
        </UniformGrid>

        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Start " VerticalAlignment="Center" />
                <DatePicker SelectedDate="{Binding StartDateTime}" Width="250" HorizontalAlignment="Left" SelectedDateFormat="Long" BorderThickness="0" />
                <TextBlock Text="End " VerticalAlignment="Center" />
                <DatePicker SelectedDate="{Binding EndDateTime}" Width="250" HorizontalAlignment="Left" SelectedDateFormat="Long" BorderThickness="0" />
                <Button Content="Query" Command="{Binding QueryCommand}" HorizontalAlignment="Right" />
            </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="Event details" />
            <TextBox Text="{Binding EventDetails}" Height="100" IsReadOnly="True" />
        </StackPanel>

        <ListView ItemsSource="{Binding Logs}" SelectedItem="{Binding SelectedLog}" Margin="0,5,0,0"
                  Background="{StaticResource ThemeBackgroundBrush}" Foreground="{StaticResource ThemeForegroundBrush}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource ListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridView.Columns>
                        <GridViewColumn Header="ID" Width="40" DisplayMemberBinding="{Binding Id}" />
                        <GridViewColumn Header="Time" Width="130" DisplayMemberBinding="{Binding Time}" />
                        <GridViewColumn Header="Event" Width="500" DisplayMemberBinding="{Binding Event}" />
                    </GridView.Columns>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
